# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data: tracked by DVC, not git (DVC adds the specific outputs itself)
data/raw/openml_cache/
*.duckdb.wal

# CI outputs and the local MLflow store (models live in the registry)
mlflow.db
mlartifacts/
mlruns/

# Serving and monitoring outputs
serving_bundle/
data/inference/
reports/

# Model files: versioned in the MLflow registry, not git. The small JSON
# results next to them (metrics, gate decisions, benchmark) are committed.
*.onnx
*.onnx.data

# Terraform: providers and local state for the emulator
infra/terraform/.terraform/
infra/terraform/terraform.tfstate*

# Online feature store, rebuilt from the offline store by make materialize
data/feature_store/online.db
data/feature_store/*.tmp

# Batch scoring store (predictions, outcomes), rebuilt by make batch-backfill
data/batch/

# Dagster instance (runs, event logs); settings come from src/orchestration/dagster.yaml
.dagster/
